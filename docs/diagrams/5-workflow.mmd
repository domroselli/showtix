    S5 --> S6["6. Second opinion<br/>reviewer subagent"]
    S6 -- "nothing real, or<br/>OUT OF SCOPE: note it" --> S7["7. Commit"]
    S6 -. "MUST FIX: a failing<br/>test, then the fix" .-> S4
  end

  Before --> Build
