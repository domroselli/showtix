flowchart TB
  subgraph Before["Before Claude builds"]
    direction LR
    S0["/clear<br/>start fresh"] --> S1["1. Align<br/>harder labs: explore, decide<br/>every lab: your answer key"]
    S1 --> S2["2. Tests first<br/>Claude writes failing tests,<br/>you check them"]
    S2 --> C1["commit<br/>the tests"]
  end

  subgraph Build["Claude builds, you check"]
    direction LR
    CL["/clear"] --> S3["3. Implement<br/>pass the tests<br/>without changing them"]
    S3 --> S4["4. Check the evidence<br/>run tests, tests unchanged,<br/>eval (Lab 2), browser"]
